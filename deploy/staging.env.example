# Copy this file to deploy/.env.staging, then replace every placeholder.
# Keep the copied file private and out of source control.
POSTGRES_DB=minaledger_staging
POSTGRES_USER=minaledger_admin
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
APP_DATABASE_USER=minaledger_app
APP_DATABASE_PASSWORD=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTER_SECRET
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTER_SECRET
CORS_ORIGIN=https://staging.example.invalid
TRUST_PROXY_HOPS=1
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
SHUTDOWN_TIMEOUT_MS=15000
LOG_LEVEL=info
WEB_PORT=8080
BACKUP_DIR=

# Set only for an explicitly invoked restore-test operation.
RESTORE_BACKUP_FILE=
RESTORE_TARGET_DATABASE=
RESTORE_CONFIRM_TARGET_DATABASE=
